import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="About" description="Learn how How to Fish Game Help researches, labels, and updates its independent English guides." canonicalPath="/about/">
  <article class="narrow section prose"><p class="eyebrow">About this site</p><h1>Help that shows its work</h1><p>{site.disclaimer}</p><h2>What we publish</h2><p>We organize public, attributable evidence into direct answers for progression blocks, bosses, island unlocks, achievements, items, and technical problems. We do not claim a large editorial team or first-hand testing that did not happen.</p><h2>How verification labels work</h2><ul><li><strong>Official:</strong> the key claim is documented by the developer, Steam store, achievements, or patch notes.</li><li><strong>Community-confirmed:</strong> more than one reproducible player source supports the answer.</li><li><strong>Mixed:</strong> official identity or patch facts are combined with gameplay-backed guidance.</li><li><strong>Needs review:</strong> evidence is incomplete; these pages are noindex or unpublished.</li></ul><h2>Corrections</h2><p>Every guide shows a source note and last-check date. Use the Contact page for correction and copyright requests once its verified email route is active.</p></article>
</BaseLayout>

